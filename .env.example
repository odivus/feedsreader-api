# ---- App ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Frontend URL, used to redirect after OAuth login and for CORS
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed CORS origins (optional)
CORS_ORIGINS=
TRUST_PROXY=false

# ---- Database (MySQL) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=rss_api
DB_USER=rss_api_user
DB_PASSWORD=change_me
# Only used by docker-compose to init the MySQL container
DB_ROOT_PASSWORD=change_me_root

# ---- JWT ----
# Long, random, secret string (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random strings stored (hashed) in the DB, not JWTs
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Set to true only when serving over HTTPS in production
COOKIE_SECURE=false

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- Logging ----
LOG_LEVEL=info

# ---- Feed-parsing worker (src/worker.ts) ----
# Standard 5-field cron expression. Default: every 15 minutes.
FEED_PARSE_CRON_SCHEDULE=*/15 * * * *
# How many feeds to fetch/parse in parallel per refresh cycle.
FEED_FETCH_CONCURRENCY=5
# Per-feed HTTP timeout, in milliseconds.
FEED_FETCH_TIMEOUT_MS=10000

# ---- Article retention ----
# Hard cap: after each refresh, keep only the N most recent articles per feed.
ARTICLES_MAX_PER_FEED=300
# Soft cap: additionally drop articles older than N days (applied first).
ARTICLES_MAX_AGE_DAYS=180
